# ===== Sports AI Analytics - Environment Configuration =====
# Copy this file to .env and fill in your values

# ===== Application =====
APP_NAME=Sports AI Analytics
APP_VERSION=2.1.0
DEBUG=false

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sports_ai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/sports_ai

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== AI / Qwen Configuration =====
AI_PROVIDER=qwen
QWEN_MODEL=qwen-2.5-72b
QWEN_BASE_URL=http://localhost:8080/v1
QWEN_API_KEY=your-api-key-here
QWEN_TIMEOUT=120
QWEN_MAX_TOKENS=2000

# ===== Scraping =====
SCRAPING_ENABLED=true
SCRAPING_INTERVAL_MINUTES=60
SCRAPING_TIMEOUT=30
SCRAPING_MAX_RETRIES=3
SCRAPING_USER_AGENT=SportsAI-Analytics/2.1

# ===== Prediction Models =====
GOAL_MODEL_VERSION=2.1.0
CORNER_MODEL_VERSION=1.3.0
CARD_MODEL_VERSION=1.1.0
PLAYER_MODEL_VERSION=1.0.0
FEATURE_VERSION=1.5.0

# ===== Scheduler =====
SCHEDULER_ENABLED=true

# ===== Logging =====
LOG_LEVEL=INFO
LOG_DIR=logs
